#!/bin/bash

set -euo pipefail

fail() {
    echo "FAIL: oqs-provider"
    exit "${1:-1}"
}

pass() {
    echo "PASS: oqs-provider"
    exit 0
}

echo "INFO: uname: $(uname -a || true)"
echo "INFO: ptest dir: $(pwd)"

if ! command -v openssl >/dev/null 2>&1; then
    echo "ERROR: openssl command not found"
    fail 1
fi

openssl version || true

modules_dir=""
for d in /usr/lib/ossl-modules /usr/lib64/ossl-modules; do
    if [ -d "$d" ]; then
        modules_dir="$d"
        break
    fi
done

if [ -z "${modules_dir}" ]; then
    echo "ERROR: could not find OpenSSL module directory (/usr/lib*/ossl-modules)"
    fail 1
fi

if [ ! -e "${modules_dir}/oqsprovider.so" ] && [ ! -e "${modules_dir}/oqsprovider.dll" ]; then
    echo "ERROR: oqsprovider module not found in ${modules_dir}"
    echo "INFO: contents of ${modules_dir}:"
    ls -la "${modules_dir}" || true
    fail 1
fi

echo "INFO: OPENSSL_MODULES=${modules_dir}"
# Some OpenSSL builds also consult OPENSSL_MODULES env var.
export OPENSSL_MODULES="${modules_dir}"

providers_out="$(
    openssl list -providers \
        -provider-path "${modules_dir}" \
        -provider oqsprovider \
        -provider default 2>&1 || true
)"
echo "${providers_out}"

if ! echo "${providers_out}" | grep -qi "oqsprovider"; then
    echo "ERROR: oqsprovider did not load (output above)"
    fail 1
fi

sig_list="$(
    openssl list -signature-algorithms \
        -provider-path "${modules_dir}" \
        -provider oqsprovider \
        -provider default 2>&1 || true
)"
echo "INFO: openssl list -signature-algorithms (oqsprovider) output:"
echo "${sig_list}"

# Pick a working signature algorithm by trial. This avoids relying on the
# formatting/contents of `openssl list` output, which varies by OpenSSL version.
SIGALG=""
for cand in \
    mldsa44 mldsa65 mldsa87 \
    ML-DSA-44 ML-DSA-65 ML-DSA-87 \
    dilithium2 dilithium3 dilithium5 \
    Dilithium2 Dilithium3 Dilithium5 \
    falcon512 falcon1024 \
    Falcon512 Falcon1024 \
; do
    rm -f /tmp/oqsprovider-sk.pem 2>/dev/null || true
    if openssl genpkey \
        -provider-path "${modules_dir}" \
        -provider oqsprovider \
        -provider default \
        -algorithm "${cand}" \
        -out /tmp/oqsprovider-sk.pem >/tmp/oqsprovider-genpkey.out 2>&1; then
        SIGALG="${cand}"
        break
    fi
done

if [ -z "${SIGALG}" ]; then
    echo "ERROR: could not generate a PQ key with oqsprovider using any known algorithm name."
    echo "INFO: last genpkey output:"
    tail -n 200 /tmp/oqsprovider-genpkey.out 2>/dev/null || true
    fail 1
fi
echo "INFO: using signature algorithm: ${SIGALG}"

tmpdir="$(mktemp -d)"
trap 'rm -rf "${tmpdir}"' EXIT

echo "hello oqs-provider" > "${tmpdir}/msg.bin"

cp -f /tmp/oqsprovider-sk.pem "${tmpdir}/sk.pem"

openssl pkey -in "${tmpdir}/sk.pem" -pubout -out "${tmpdir}/pk.pem" || fail $?

openssl pkeyutl -sign -inkey "${tmpdir}/sk.pem" -in "${tmpdir}/msg.bin" -out "${tmpdir}/sig.bin" || fail $?

openssl pkeyutl -verify -pubin -inkey "${tmpdir}/pk.pem" -in "${tmpdir}/msg.bin" -sigfile "${tmpdir}/sig.bin" || fail $?

pass

